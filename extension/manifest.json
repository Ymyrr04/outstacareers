{
  "manifest_version": 3,
  "name": "OutSta Outreach Importer",
  "version": "1.6.0",
  "description": "Import LinkedIn profiles into OutSta Outreach as client prospects.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://ohxtavjababtrcrkgndq.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "options_page": "options.html",
  "icons": { "48": "icon.png", "128": "icon.png" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["scraper.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon.png"],
      "matches": ["https://www.linkedin.com/*"]
    }
  ]
}
